plugins {
    id 'com.android.application'
    id 'com.chaquo.python'
}

android {
    namespace 'com.example.pdfsorter'
    compileSdk 35
    defaultConfig {
        applicationId 'com.example.pdfsorter'
        minSdk 26
        targetSdk 35
        versionCode 1
        versionName '1.0-python'
        ndk { abiFilters 'arm64-v8a', 'armeabi-v7a', 'x86_64' }
        python { version '3.13' }
    }
}

chaquopy { defaultConfig { pip { install 'pypdf==6.16.2' } } }
